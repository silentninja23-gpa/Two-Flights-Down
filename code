                closePuzzleModal();
                updateHUDStatus(`ANOMALY RESOLVED! (${floor.anomalyMessage}) Door Unlocked.`);
            }, 800);
        }

        document.getElementById('close-puzzle-btn').addEventListener('click', closePuzzleModal);

        function descendToNextFloor() {
            currentFloor++;
            document.getElementById('floor-indicator').innerText = `FLOOR ${currentFloor}`;
            audio.updateAmbient(currentFloor);

            player.x = 120;
            updateHUDStatus("STATUS: DOOR LOCKED — LOCATE FLOOR ANOMALY");

            if (currentFloor >= TOTAL_FLOORS) {
                triggerGameOver("THE BOTTOM REACHED", "You inspected every anomaly and descended past where the floor plan ends. You are stranded below ground in complete isolation.");
            }
        }

        function triggerGameOver(titleText, descText) {
            isGameOver = true;
            document.getElementById('end-title').innerText = titleText;
            document.getElementById('end-desc').innerText = descText;
            document.getElementById('end-screen').classList.remove('hidden');
        }

        /* --- CONTROL BINDINGS --- */
        function setupControls() {
            // Keyboard controls
            window.addEventListener('keydown', (e) => {
                if (e.code === 'KeyA' || e.code === 'ArrowLeft') keys.Left = true;
                if (e.code === 'KeyD' || e.code === 'ArrowRight') keys.Right = true;
                if (e.code === 'KeyE' || e.code === 'Space') {
                    e.preventDefault();
                    handleInteraction();
                }
            });

            window.addEventListener('keyup', (e) => {
                if (e.code === 'KeyA' || e.code === 'ArrowLeft') keys.Left = false;
                if (e.code === 'KeyD' || e.code === 'ArrowRight') keys.Right = false;
            });

            // On-screen touch button controls for mobile
            const btnLeft = document.getElementById('btn-left');
            const btnRight = document.getElementById('btn-right');
            const btnAction = document.getElementById('btn-action');
            const mobileControls = document.getElementById('mobile-controls');

            // Detect touch device
            if ('ontouchstart' in window || navigator.maxTouchPoints > 0) {
                mobileControls.classList.remove('hidden');
            }

            const bindTouchBtn = (btn, keyName) => {
                btn.addEventListener('touchstart', (e) => { e.preventDefault(); keys[keyName] = true; });
                btn.addEventListener('touchend', (e) => { e.preventDefault(); keys[keyName] = false; });
                btn.addEventListener('mousedown', () => { keys[keyName] = true; });
                btn.addEventListener('mouseup', () => { keys[keyName] = false; });
            };

            bindTouchBtn(btnLeft, 'Left');
            bindTouchBtn(btnRight, 'Right');

            btnAction.addEventListener('click', (e) => {
                e.preventDefault();
                handleInteraction();
            });

            // Click prompt banner to interact
            document.getElementById('interactive-prompt').addEventListener('click', handleInteraction);
        }

        /* --- RENDERING PIPELINE --- */
        let timeGlobal = 0;

        function drawScene() {
            const floor = getFloor(currentFloor);
            const groundY = canvas.height - GROUND_Y_OFFSET;
            player.y = groundY - player.height;

            // Camera follow (Horizontal scrolling centered on player)
            const cameraX = Math.max(0, Math.min(LEVEL_WIDTH - canvas.width, player.x - canvas.width / 2));

            ctx.save();
            ctx.translate(-cameraX, 0);

            // 1. Background & Walls
            ctx.fillStyle = floor.crimson ? '#1a0505' : '#0c0c10';
            ctx.fillRect(0, 0, LEVEL_WIDTH, canvas.height);

            // Concrete Wall Tiles Pattern
            ctx.strokeStyle = floor.crimson ? 'rgba(80, 20, 20, 0.25)' : 'rgba(255, 255, 255, 0.04)';
            ctx.lineWidth = 2;
            const tileSize = 80;
            for (let x = 0; x < LEVEL_WIDTH; x += tileSize) {
                for (let y = 0; y < groundY; y += tileSize) {
                    ctx.strokeRect(x, y, tileSize, tileSize);
                }
            }

            // 2. Stairs Backdrop (Descending stair steps leading down at right end)
            ctx.fillStyle = '#111116';
            ctx.beginPath();
            ctx.moveTo(980, groundY);
            ctx.lineTo(LEVEL_WIDTH, groundY + 120);
            ctx.lineTo(LEVEL_WIDTH, canvas.height);
            ctx.lineTo(980, canvas.height);
            ctx.closePath();
            ctx.fill();

            // 3. Landing Floor & Baseboard
            ctx.fillStyle = '#1c1c22';
            ctx.fillRect(0, groundY, LEVEL_WIDTH, canvas.height - groundY);

            ctx.fillStyle = '#dc2626';
            ctx.fillRect(0, groundY - 6, LEVEL_WIDTH, 6); // Yellow/Red warning stripe line

            // 4. Floor Sign Stencil
            ctx.save();
            ctx.translate(floor.signX, groundY - 140);
            if (currentFloor === 1) ctx.scale(1, -1); // Upside-down anomaly
            ctx.fillStyle = '#09090b';
            ctx.fillRect(-10, -35, 160, 50);
            ctx.strokeStyle = '#dc2626';
            ctx.lineWidth = 3;
            ctx.strokeRect(-10, -35, 160, 50);

            ctx.fillStyle = '#dc2626';
            ctx.font = 'bold 22px "VT323", monospace';
            ctx.fillText(floor.signText, 0, 0);
            ctx.restore();

            // 6. Floor Anomaly Renderings
            renderAnomaly(floor, groundY);

            // 7. Threshold Exit Door
            ctx.save();
            ctx.translate(floor.doorX, groundY - 120);

            // Door Frame
            ctx.fillStyle = '#18181b';
            ctx.fillRect(-5, -5, 60, 125);

            // Door Body
            ctx.fillStyle = floor.doorOpened ? '#09090b' : '#27272a';
            ctx.fillRect(0, 0, floor.doorOpened ? 12 : 50, 120);

            // Door Handle
            if (!floor.doorOpened) {
                ctx.fillStyle = '#9ca3af';
                ctx.fillRect(8, 62, 10, 5);
                // Lock status LED
                ctx.fillStyle = floor.doorLocked ? '#ef4444' : '#22c55e';
                ctx.fillRect(10, 52, 6, 6);
            }
            ctx.restore();

            // 8. Player Rendering & Flashlight Beam
            renderPlayer(groundY);

            // 9. Environmental Fog / Horror Overlays
            if (floor.foggy) {
                ctx.fillStyle = `rgba(16, 185, 129, ${0.08 + Math.sin(timeGlobal * 2) * 0.03})`;
                ctx.fillRect(cameraX, 0, canvas.width, canvas.height);
            }

            ctx.restore();
        }

        function renderAnomaly(floor, groundY) {
            const ax = floor.anomalyX;
            const ay = groundY - 80;

            ctx.save();
            if (floor.anomalyType === 'keycard') {
                ctx.fillStyle = '#1e293b';
                ctx.fillRect(ax - 20, ay, 40, 55);
                ctx.strokeStyle = '#38bdf8';
                ctx.lineWidth = 1.5;
                ctx.strokeRect(ax - 16, ay + 4, 32, 46);
            } else if (floor.anomalyType === 'breaker') {
                ctx.fillStyle = '#d97706';
                ctx.fillRect(ax - 15, ay + 10, 30, 45);
                // Sparks when unsolved
                if (!floor.anomalySolved && Math.random() < 0.3) {
                    ctx.fillStyle = '#fef08a';
                    ctx.fillRect(ax + (Math.random() * 20 - 10), ay + 20, 4, 4);
                }
            } else if (floor.anomalyType === 'cipher') {
                ctx.fillStyle = '#0284c7';
                ctx.fillRect(ax - 22, ay - 10, 44, 60);
                ctx.fillStyle = '#ffffff';
                ctx.font = '10px monospace';
                ctx.fillText(floor.anomalySolved ? "VERIFIED" : "SHIFTING", ax - 20, ay + 20);
            } else if (floor.anomalyType === 'orb') {
                const orbY = ay + Math.sin(timeGlobal * 3) * 12;
                const grad = ctx.createRadialGradient(ax, orbY, 2, ax, orbY, 24);
                grad.addColorStop(0, '#6ee7b7');
                grad.addColorStop(1, 'rgba(5, 150, 105, 0)');
                ctx.fillStyle = grad;
                ctx.beginPath();
                ctx.arc(ax, orbY, 24, 0, Math.PI * 2);
                ctx.fill();
            } else if (floor.anomalyType === 'mirrors') {
                ctx.strokeStyle = '#a855f7';
                ctx.lineWidth = 4;
                ctx.strokeRect(ax - 20, ay - 20, 40, 70);
            } else if (floor.anomalyType === 'circuit') {
                ctx.fillStyle = '#3b82f6';
                ctx.fillRect(ax - 18, ay, 36, 60);
            } else if (floor.anomalyType === 'terminal') {
                ctx.fillStyle = '#7f1d1d';
                ctx.fillRect(ax - 18, ay, 36, 60);
                ctx.fillStyle = '#ef4444';
                ctx.fillRect(ax - 12, ay + 8, 24, 18);
            }
            ctx.restore();
        }

        function renderPlayer(groundY) {
            const px = player.x;
            const py = player.y;

            ctx.save();

            // Flashlight Spotlight Cone
            const torchDir = player.facingLeft ? -1 : 1;
            const torchX = px + (player.facingLeft ? 4 : player.width - 4);
            const torchY = py + 24;

            const torchGrad = ctx.createRadialGradient(torchX, torchY, 4, torchX + torchDir * 240, torchY, 180);
            torchGrad.addColorStop(0, 'rgba(255, 255, 230, 0.45)');
            torchGrad.addColorStop(1, 'rgba(0,0,0,0)');

            ctx.fillStyle = torchGrad;
            ctx.beginPath();
            ctx.moveTo(torchX, torchY);
            ctx.lineTo(torchX + torchDir * 280, torchY - 80);
            ctx.lineTo(torchX + torchDir * 280, torchY + 120);
            ctx.closePath();
            ctx.fill();

            // Player Silhouette Character Sprite
            ctx.fillStyle = '#020617';
            ctx.fillRect(px, py, player.width, player.height); // Main body

            // Trench coat / outfit details
            ctx.fillStyle = '#1e293b';
            ctx.fillRect(px + 4, py + 18, player.width - 8, 30);

            // Head & Eyes
            ctx.fillStyle = '#334155';
            ctx.fillRect(px + 6, py + 4, 16, 14);

            // Glowing Flashlight Lens
            ctx.fillStyle = '#fef08a';
            ctx.fillRect(torchX - 2, torchY - 2, 4, 4);

            // Simple Walking Leg Animation
            if (player.isMoving) {
                const legOffset = Math.sin(player.animTimer * 12) * 8;
                ctx.fillStyle = '#0f172a';
                ctx.fillRect(px + 4, py + 48, 8, 16 + legOffset);
                ctx.fillRect(px + 16, py + 48, 8, 16 - legOffset);
            } else {
                ctx.fillStyle = '#0f172a';
                ctx.fillRect(px + 4, py + 48, 8, 16);
                ctx.fillRect(px + 16, py + 48, 8, 16);
            }

            ctx.restore();
        }

        /* --- GAME LOOP & UPDATE --- */
        let lastTime = 0;

        function update(delta) {
            if (!isStarted || isGameOver) return;

            player.isMoving = false;
            player.vx = 0;

            if (keys.Left) {
                player.vx = -player.speed;
                player.facingLeft = true;
                player.isMoving = true;
            } else if (keys.Right) {
                player.vx = player.speed;
                player.facingLeft = false;
                player.isMoving = true;
            }

            player.x += player.vx;

            // Boundary limits
            player.x = Math.max(40, Math.min(LEVEL_WIDTH - 80, player.x));

            if (player.isMoving) {
                player.animTimer += delta;
                if (Math.sin(player.animTimer * 12) > 0.9) {
                    audio.playFootstep(currentFloor);
                }
            }

            checkInteractions();
        }

        function gameLoop(timestamp) {
            const delta = Math.min((timestamp - lastTime) / 1000, 0.1);
            lastTime = timestamp;
            timeGlobal += delta;

            update(delta);
            drawScene();

            requestAnimationFrame(gameLoop);
        }

        /* --- INITIALIZATION --- */
        document.getElementById('start-btn').addEventListener('click', () => {
            audio.init();
            document.getElementById('start-screen').classList.add('opacity-0');
            setTimeout(() => {
                document.getElementById('start-screen').classList.add('hidden');
            }, 700);

            isStarted = true;
            updateHUDStatus("STATUS: DOOR LOCKED — LOCATE FLOOR ANOMALY");
        });

        document.getElementById('restart-btn').addEventListener('click', () => {
            window.location.reload();
        });

        setupControls();
        requestAnimationFrame(gameLoop);

    </script>
</body>
</html>
