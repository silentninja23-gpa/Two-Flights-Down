        function solveCurrentPuzzle(floor) {
            floor.anomalySolved = true;
            floor.doorLocked = false;
            audio.playAnomalyDiscovered();
            document.getElementById('puzzle-status').innerText = "PUZZLE SOLVED! DOOR UNLOCKED.";
            document.getElementById('puzzle-status').className = "text-xs font-bold text-center h-5 text-emerald-400 tracking-wider";
