<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Two Flights Down - 2D Edition</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=VT323&display=swap');

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #050508;
            color: #e2e8f0;
            font-family: 'Share Tech Mono', monospace;
            user-select: none;
            -webkit-user-select: none;
        }

        #game-canvas {
            width: 100%;
            height: 100%;
            display: block;
            image-rendering: pixelated;
        }

        /* CRT Scanlines & Grain Effects */
        .crt-overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.4) 50%), 
                        linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));
            background-size: 100% 3px, 6px 100%;
            z-index: 10;
        }

        .vignette {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            box-shadow: 0 0 140px rgba(0, 0, 0, 0.95) inset;
            pointer-events: none;
            z-index: 11;
        }

        .glitch-text {
            font-family: 'VT323', monospace;
            text-shadow: 2px 0 #dc2626, -2px 0 #0284c7;
        }

        /* Virtual D-Pad / Controls for Touch */
        .touch-btn {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            backdrop-filter: blur(4px);
            touch-action: manipulation;
        }
        .touch-btn:active {
            background: rgba(239, 68, 68, 0.3);
            border-color: #ef4444;
        }

        /* Puzzle Modal overlay styling */
        .puzzle-modal {
            background: rgba(10, 10, 15, 0.95);
            border: 2px solid #dc2626;
            box-shadow: 0 0 30px rgba(220, 38, 38, 0.4);
        }
    </style>
</head>
<body class="bg-black">

    <div id="game-container" class="relative w-full h-full">
        <canvas id="game-canvas"></canvas>

        <!-- CRT & Atmosphere FX -->
        <div class="crt-overlay"></div>
        <div class="vignette"></div>

        <!-- HUD Header -->
        <div id="hud" class="absolute top-5 left-6 z-20 pointer-events-none flex flex-col gap-2">
            <div id="floor-indicator" class="text-3xl font-black tracking-widest text-red-600 glitch-text">FLOOR 0</div>
            
            <!-- Sanity / Health Meter -->
            <div class="flex items-center gap-2 bg-stone-950/80 p-2 rounded-lg border border-red-900/50 backdrop-blur-sm w-64">
                <i class="fa-solid fa-brain text-red-500 text-sm"></i>
                <div class="flex-1">
                    <div class="flex justify-between text-[10px] font-mono text-stone-300 mb-1">
                        <span>SANITY STABILITY</span>
                        <span id="sanity-val" class="text-red-400 font-bold">100%</span>
                    </div>
                    <div class="w-full h-2.5 bg-stone-900 rounded-full overflow-hidden border border-stone-800">
                        <div id="sanity-bar" class="h-full bg-red-600 transition-all duration-300 rounded-full" style="width: 100%;"></div>
                    </div>
                </div>
            </div>

            <div id="status-subtext" class="text-xs uppercase tracking-wider text-stone-400 font-mono bg-black/60 px-3 py-1.5 rounded border border-stone-800 max-w-sm backdrop-blur-sm">
                STATUS: DOOR LOCKED — SOLVE FLOOR PUZZLE
            </div>
        </div>

        <!-- Interactive Prompt Floating Banner -->
        <div id="interactive-prompt" class="hidden absolute bottom-24 left-1/2 -translate-x-1/2 z-20 font-mono flex items-center gap-3 bg-stone-950/90 px-5 py-2.5 rounded-xl border border-red-500/50 backdrop-blur-md shadow-2xl">
            <span class="bg-red-600 text-white font-bold px-2.5 py-1 rounded text-xs shadow-inner" id="interact-key">E / TAP</span>
            <span id="interact-text" class="text-stone-200 text-sm tracking-wide">INSPECT ANOMALY PUZZLE</span>
        </div>

        <!-- Interactive Puzzle Modal Overlay -->
        <div id="puzzle-modal" class="hidden absolute inset-0 z-40 flex items-center justify-center bg-black/80 backdrop-blur-md p-4">
            <div class="puzzle-modal max-w-md w-full p-6 rounded-2xl flex flex-col gap-4 text-stone-200 font-mono relative">
                <button id="close-puzzle-btn" class="absolute top-4 right-4 text-stone-400 hover:text-white text-lg"><i class="fa-solid fa-xmark"></i></button>
                
                <h3 id="puzzle-title" class="text-xl font-bold text-red-500 glitch-text tracking-wide border-b border-stone-800 pb-2">FLOOR PUZZLE</h3>
                <p id="puzzle-instructions" class="text-xs text-stone-400 leading-relaxed">Solve the mechanism to align local reality and disengage the landing lock.</p>

                <!-- Dynamic Container for active puzzle UI -->
                <div id="puzzle-content" class="w-full bg-stone-950/80 p-4 rounded-xl border border-stone-800 my-2 flex flex-col items-center justify-center min-h-[160px]">
                    <!-- Injected via JavaScript -->
                </div>

                <div id="puzzle-status" class="text-xs font-bold text-center h-5 text-amber-400 tracking-wider"></div>
            </div>
        </div>

        <!-- Touch / On-screen Controls for Mobile -->
        <div id="mobile-controls" class="hidden absolute bottom-6 inset-x-6 z-30 flex justify-between items-end pointer-events-none">
            <div class="flex gap-2 pointer-events-auto">
                <button id="btn-left" class="touch-btn w-16 h-16 flex items-center justify-center text-white text-xl active:scale-95 transition-transform"><i class="fa-solid fa-arrow-left"></i></button>
                <button id="btn-right" class="touch-btn w-16 h-16 flex items-center justify-center text-white text-xl active:scale-95 transition-transform"><i class="fa-solid fa-arrow-right"></i></button>
            </div>
            <div class="flex gap-2 pointer-events-auto">
                <button id="btn-action" class="touch-btn w-20 h-16 flex items-center justify-center text-red-400 font-bold text-sm tracking-wider active:scale-95 transition-transform border-red-500/40">INTERACT</button>
            </div>
        </div>

        <!-- Start Overlay -->
        <div id="start-screen" class="absolute inset-0 z-50 flex items-center justify-center bg-black/95 backdrop-blur-md transition-opacity duration-700 p-4">
            <div class="max-w-md w-full bg-stone-900/90 border border-red-900/60 p-7 rounded-2xl shadow-2xl text-center flex flex-col items-center gap-5">
                <div>
                    <h1 class="text-5xl font-black tracking-widest text-red-600 glitch-text mb-1">TWO FLIGHTS DOWN</h1>
                    <p class="text-xs font-mono tracking-widest text-stone-400 uppercase">2D Side-Scrolling Horror</p>
                </div>

                <div class="w-full h-px bg-gradient-to-r from-transparent via-red-800/60 to-transparent"></div>

                <div class="text-left text-xs text-stone-300 space-y-2 font-mono bg-black/70 p-4 rounded-xl border border-stone-800 w-full">
                    <p class="text-red-500 font-bold uppercase tracking-wider mb-1"><i class="fa-solid fa-triangle-exclamation mr-1.5"></i>DESCENT RULES:</p>
                    <p>• Walk down the stairwell landings. Each lower door is <span class="text-red-400 font-semibold">LOCKED</span>.</p>
                    <p>• Search each landing and inspect its <span class="text-amber-400 font-semibold">ANOMALY</span> to unlock the exit door.</p>
                    <p>• Turn back if reality distorts too heavily... or press forward.</p>
                </div>

                <div class="w-full text-[11px] font-mono text-stone-400 bg-stone-800/40 p-3 rounded-lg border border-stone-700/50 text-left">
                    <span class="text-stone-200 font-bold block mb-1">CONTROLS:</span>
                    A/D or Left/Right Arrows — Move<br>
                    E / Space / Mouse Click — Inspect / Open Door<br>
                    Touch Buttons — Mobile Play
                </div>

                <button id="start-btn" class="w-full py-3.5 bg-red-700 hover:bg-red-600 text-white font-mono font-bold tracking-widest text-sm rounded-xl shadow-lg hover:shadow-red-900/50 transition-all duration-300 border border-red-400/30 active:scale-95">
                    BEGIN DESCENT
                </button>
            </div>
        </div>

        <!-- End Overlay -->
        <div id="end-screen" class="hidden absolute inset-0 z-50 flex items-center justify-center bg-black/95 transition-opacity duration-1000 p-4">
            <div class="max-w-md w-full text-center space-y-5 bg-stone-900/90 p-8 rounded-2xl border border-red-900/60 shadow-2xl">
                <h2 id="end-title" class="text-4xl text-red-600 font-mono tracking-widest glitch-text">THE BOTTOM REACHED</h2>
                <p id="end-desc" class="text-stone-300 font-mono text-xs leading-relaxed border-y border-stone-800 py-5">
                    You inspected every anomaly and descended past where the floor plan ends. The stairwell above you has flattened into concrete walls. You are stranded below ground.
                </p>
                <button id="restart-btn" class="w-full py-3 bg-stone-800 hover:bg-stone-700 text-stone-200 font-mono tracking-wider rounded-lg border border-stone-600">
                    RESTART DESCENT
                </button>
            </div>
        </div>
    </div>

    <script>
        /* --- PROCEDURAL AUDIO SYNTHESIZER --- */
        class HorrorAudioEngine {
            constructor() {
                this.ctx = null;
                this.humOsc = null;
                this.humOsc2 = null;
                this.humGain = null;
                this.droneFilter = null;
                this.initialized = false;
            }

            init() {
                if (this.initialized) return;
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                this.ctx = new AudioCtx();

                this.humOsc = this.ctx.createOscillator();
                this.humOsc2 = this.ctx.createOscillator();
                this.humGain = this.ctx.createGain();

                this.humOsc.type = 'sawtooth';
                this.humOsc.frequency.setValueAtTime(45, this.ctx.currentTime);

                this.humOsc2.type = 'sine';
                this.humOsc2.frequency.setValueAtTime(47.5, this.ctx.currentTime);

                this.droneFilter = this.ctx.createBiquadFilter();
                this.droneFilter.type = 'lowpass';
                this.droneFilter.frequency.setValueAtTime(120, this.ctx.currentTime);

                this.humGain.gain.setValueAtTime(0.08, this.ctx.currentTime);

                this.humOsc.connect(this.droneFilter);
                this.humOsc2.connect(this.droneFilter);
                this.droneFilter.connect(this.humGain);
                this.humGain.connect(this.ctx.destination);

                this.humOsc.start();
                this.humOsc2.start();
                this.initialized = true;
            }

            playFootstep(depth) {
                if (!this.initialized || this.ctx.state !== 'running') return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                const filter = this.ctx.createBiquadFilter();

                const baseFreq = Math.max(30, 90 - depth * 8);
                osc.type = depth > 3 ? 'triangle' : 'sine';
                osc.frequency.setValueAtTime(baseFreq + (Math.random() * 10 - 5), this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(10, this.ctx.currentTime + 0.1);

                filter.type = 'lowpass';
                filter.frequency.setValueAtTime(220, this.ctx.currentTime);

                gain.gain.setValueAtTime(0.18, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.1);

                osc.connect(filter);
                filter.connect(gain);
                gain.connect(this.ctx.destination);

                osc.start();
                osc.stop(this.ctx.currentTime + 0.11);
            }

            playDoorUnlock() {
                if (!this.initialized) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'square';
                osc.frequency.setValueAtTime(200, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(50, this.ctx.currentTime + 0.3);

                gain.gain.setValueAtTime(0.15, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.3);

                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.31);
            }

            playCreak() {
                if (!this.initialized) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sawtooth';
                const freq = 160 + Math.random() * 150;
                osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
                osc.frequency.linearRampToValueAtTime(freq - 90, this.ctx.currentTime + 0.5);

                gain.gain.setValueAtTime(0.05, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.0001, this.ctx.currentTime + 0.5);

                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.52);
            }

            playAnomalyDiscovered() {
                if (!this.initialized) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(120, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(520, this.ctx.currentTime + 0.6);

                gain.gain.setValueAtTime(0.01, this.ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0.25, this.ctx.currentTime + 0.2);
                gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.7);

                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.72);
            }

            playSanityDamage() {
                if (!this.initialized) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(150, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(40, this.ctx.currentTime + 0.4);

                gain.gain.setValueAtTime(0.3, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.4);

                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.42);
            }

            updateAmbient(floorNum) {
                if (!this.initialized) return;
                const targetFreq = Math.max(20, 45 - floorNum * 4);
                this.humOsc.frequency.setTargetAtTime(targetFreq, this.ctx.currentTime, 1.0);
                this.droneFilter.frequency.setTargetAtTime(120 + floorNum * 35, this.ctx.currentTime, 1.0);
            }
        }

        const audio = new HorrorAudioEngine();

        /* --- CANVAS & ENGINE SETUP --- */
        const canvas = document.getElementById('game-canvas');
        const ctx = canvas.getContext('2d');

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        /* --- GAME CONSTANTS & STATE --- */
        const LEVEL_WIDTH = 1200;
        const GROUND_Y_OFFSET = 180;

        let isStarted = false;
        let isGameOver = false;
        let currentFloor = 0;
        let sanity = 100;
        const maxSanity = 100;
        const TOTAL_FLOORS = 20;
        const floorsMap = {};

        function damageSanity(amount) {
            sanity = Math.max(0, sanity - amount);
            audio.playSanityDamage();

            // Update UI
            const bar = document.getElementById('sanity-bar');
            const val = document.getElementById('sanity-val');
            if (bar && val) {
                bar.style.width = `${sanity}%`;
                val.innerText = `${sanity}%`;
            }

            // Screen glitch visual impact
            const container = document.getElementById('game-container');
            container.classList.add('animate-ping');
            setTimeout(() => container.classList.remove('animate-ping'), 200);

            const status = document.getElementById('puzzle-status');
            if (status) {
                status.innerText = `WRONG ANSWER! SANITY DAMAGED (-${amount}%)`;
                status.className = "text-xs font-bold text-center h-5 text-red-500 tracking-wider animate-bounce";
            }

            if (sanity <= 0) {
                triggerGameOver("SANITY LOST", "Your mind succumbed to the anomalies of the lower stairwell landings. You collapsed into the darkness.");
            }
        }

        function getFloor(floorIndex) {
            if (!floorsMap[floorIndex]) {
                floorsMap[floorIndex] = new FloorData(floorIndex);
            }
            return floorsMap[floorIndex];
        }

        const player = {
            x: 120,
            y: 0,
            width: 28,
            height: 64,
            vx: 0,
            speed: 3.2,
            facingLeft: false,
            animTimer: 0,
            isMoving: false,
            flashlightAngle: 0
        };

        const keys = { Left: false, Right: false, Interact: false };

        /* --- FLOOR ANOMALIES & STRUCTURE DATA --- */
        class FloorData {
            constructor(floorIndex) {
                this.index = floorIndex;
                this.doorLocked = true;
                this.doorOpened = false;
                this.anomalySolved = false;

                // Environment coordinates
                this.doorX = 1040;
                this.signX = 180;
                this.anomalyX = 600;

                // Anomaly descriptions & dynamic properties
                this.setupFloorTraits();
            }

            setupFloorTraits() {
                switch(this.index) {
                    case 0:
                        this.signText = "FLOOR 0 - ENTRANCE";
                        this.anomalyPrompt = "SWIPE KEYCARD";
                        this.anomalyMessage = "Security clearance confirmed.";
                        this.anomalyType = "keycard";
                        break;
                    case 1:
                        this.signText = "FLOOR L1";
                        this.anomalyPrompt = "BALANCE VOLTAGE";
                        this.anomalyMessage = "Power balanced to 120V.";
                        this.anomalyType = "breaker";
                        this.flickerLight = true;
                        break;
                    case 2:
                        this.signText = "FLOOR 2 ?";
                        this.anomalyPrompt = "DECODE CIPHER";
                        this.anomalyMessage = "Stencil cipher realigned.";
                        this.anomalyType = "cipher";
                        break;
                    case 3:
                        this.signText = "RESONANCE";
                        this.anomalyPrompt = "MATCH FREQUENCY";
                        this.anomalyMessage = "Frequency harmonic stabilized.";
                        this.anomalyType = "orb";
                        this.foggy = true;
                        break;
                    case 4:
                        this.signText = "BEHIND YOU";
                        this.anomalyPrompt = "ALIGN MIRROR";
                        this.anomalyMessage = "Silhouette illuminated.";
                        this.anomalyType = "mirrors";
                        this.darkness = true;
                        break;
                    case 5:
                        this.signText = "LOOP // 05";
                        this.anomalyPrompt = "RECONNECT CIRCUIT";
                        this.anomalyMessage = "Circuit loop bypassed.";
                        this.anomalyType = "circuit";
                        break;
                    case 6:
                        this.signText = "PRESSURE CRITICAL";
                        this.anomalyPrompt = "RELEASE VALVES";
                        this.anomalyMessage = "Pressure equilibrium restored.";
                        this.anomalyType = "valves";
                        break;
                    case 7:
                        this.signText = "MEMORY BANK";
                        this.anomalyPrompt = "REPEAT KEYPAD PATTERN";
                        this.anomalyMessage = "Memory matrix accepted.";
                        this.anomalyType = "keypad";
                        break;
                    case 8:
                        this.signText = "ECHO CHAMBER";
                        this.anomalyPrompt = "CALIBRATE PENDULUM";
                        this.anomalyMessage = "Pendulum synced to real space.";
                        this.anomalyType = "pendulum";
                        break;
                    case 9:
                        this.signText = "PHASE DRIFT";
                        this.anomalyPrompt = "ALIGN PHASE WAVE";
                        this.anomalyMessage = "Phase offset zeroed out.";
                        this.anomalyType = "phasewave";
                        break;
                    case 10:
                        this.signText = "STATIC SUB-LEVEL";
                        this.anomalyPrompt = "DECODE MORSE CODE";
                        this.anomalyMessage = "Signal transmission decrypted.";
                        this.anomalyType = "morse";
                        this.flickerLight = true;
                        break;
                    case 11:
                        this.signText = "OPTICAL SHIFT";
                        this.anomalyPrompt = "SCAN UV FREQUENCY";
                        this.anomalyMessage = "Hidden pattern revealed.";
                        this.anomalyType = "uvscan";
                        break;
                    case 12:
                        this.signText = "GRAVITY WELL";
                        this.anomalyPrompt = "ALIGN GRAVITY DIAL";
                        this.anomalyMessage = "Gravity vector stabilized.";
                        this.anomalyType = "gravity";
                        break;
                    case 13:
                        this.signText = "OXYGEN DEPRIVATION";
                        this.anomalyPrompt = "FLUSH O2 SCRUBBERS";
                        this.anomalyMessage = "Oxygen scrubbers activated.";
                        this.anomalyType = "oxygen";
                        this.foggy = true;
                        break;
                    case 14:
                        this.signText = "QUANTUM ENTANGLEMENT";
                        this.anomalyPrompt = "STABILIZE PARTICLES";
                        this.anomalyMessage = "Quantum flux locked.";
                        this.anomalyType = "quantum";
                        break;
                    case 15:
                        this.signText = "THERMAL LEAK";
                        this.anomalyPrompt = "COOL CORE TEMP";
                        this.anomalyMessage = "Core temperature normalized.";
                        this.anomalyType = "thermal";
                        break;
                    case 16:
                        this.signText = "TIME DILATION";
                        this.anomalyPrompt = "STOP DIGITAL CLOCK";
                        this.anomalyMessage = "Chronometer synchronized.";
                        this.anomalyType = "chronometer";
                        break;
                    case 17:
                        this.signText = "NEURAL DECAY";
                        this.anomalyPrompt = "MATCH PATTERN GRID";
                        this.anomalyMessage = "Neural link stabilized.";
                        this.anomalyType = "neuralgrid";
                        break;
                    case 18:
                        this.signText = "SECTOR NOISE";
                        this.anomalyPrompt = "TUNE AUDIO EQUALIZER";
                        this.anomalyMessage = "Acoustic distortion filtered.";
                        this.anomalyType = "equalizer";
                        break;
                    case 19:
                    default:
                        this.signText = "THE ABYSS THRESHOLD";
                        this.anomalyPrompt = "MASTER SYSTEM OVERRIDE";
                        this.anomalyMessage = "Final gate disengaged.";
                        this.anomalyType = "terminal";
                        this.crimson = true;
                        break;
                }
            }
        }

        /* --- INTERACTION & PUZZLE SYSTEM --- */
        let activeInteractTarget = null;
        let isPuzzleOpen = false;

        function updateHUDStatus(message) {
            const statusEl = document.getElementById('status-subtext');
            if (statusEl) {
                statusEl.innerText = message;
            }
        }

        function checkInteractions() {
            if (isPuzzleOpen) return;
            const floor = getFloor(currentFloor);
            const promptEl = document.getElementById('interactive-prompt');
            const interactText = document.getElementById('interact-text');

            activeInteractTarget = null;

            const distAnomaly = Math.abs(player.x - floor.anomalyX);
            const distDoor = Math.abs(player.x - floor.doorX);

            if (distAnomaly < 50 && !floor.anomalySolved) {
                activeInteractTarget = 'anomaly';
                interactText.innerText = floor.anomalyPrompt;
                promptEl.classList.remove('hidden');
            } else if (distDoor < 50) {
                activeInteractTarget = 'door';
                interactText.innerText = floor.doorLocked ? "TRY DOOR (LOCKED)" : "PROCEED DOWN STAIRS";
                promptEl.classList.remove('hidden');
            } else {
                promptEl.classList.add('hidden');
            }
        }

        function handleInteraction() {
            if (!activeInteractTarget || !isStarted || isGameOver || isPuzzleOpen) return;

            const floor = getFloor(currentFloor);

            if (activeInteractTarget === 'anomaly') {
                openPuzzleModal(floor);
            } else if (activeInteractTarget === 'door') {
                if (floor.doorLocked) {
                    audio.playCreak();
                    updateHUDStatus("DOOR IS LOCKED! Solve this floor's puzzle first.");
                } else {
                    audio.playDoorUnlock();
                    floor.doorOpened = true;
                    descendToNextFloor();
                }
            }
        }

        function openPuzzleModal(floor) {
            isPuzzleOpen = true;
            const modal = document.getElementById('puzzle-modal');
            const title = document.getElementById('puzzle-title');
            const instructions = document.getElementById('puzzle-instructions');
            const content = document.getElementById('puzzle-content');
            const status = document.getElementById('puzzle-status');

            status.innerText = "";
            modal.classList.remove('hidden');

            switch(floor.anomalyType) {
